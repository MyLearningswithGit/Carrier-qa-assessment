meta {
  name: Login - Wrong Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "wrong-password-definitely-incorrect",
    "expiresInMins": 30
  }
}

tests {
  test("returns HTTP 400 for an incorrect password", function() {
    expect(res.status).to.equal(400);
  });

  test("response body contains a message field", function() {
    expect(res.body).to.have.property("message");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

docs {
  Negative auth scenario. DummyJSON validates credentials server-side even
  though write endpoints are mocked elsewhere — auth is a real check against
  the seeded user table, so a wrong password reliably returns 400.
}
